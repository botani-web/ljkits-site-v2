// ---------------------------------------------------------------------------
// Schéma de la base LJKITS.
// Quatre domaines : les kits, le règlement, le compte admin, et la boutique
// (grades, packs, commandes).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Les deux familles de kits.
/// GRATUIT  : kit classique, se débloque en coins gagnés en jouant.
/// EXCLUSIF : kit maison, se débloque en coins AUSSI, mais peut être
///            proposé à l'achat en euros pour raccourcir le grind (phase 2).
enum TypeKit {
  GRATUIT
  EXCLUSIF
}

model Kit {
  id String @id @default(cuid())

  /// Identifiant dans l'URL : /kits/kitsune. Modifiable depuis l'admin.
  slug  String  @unique
  /// Nom affiché : "Kitsune".
  nom   String
  /// Idéogramme décoratif, kits exclusifs uniquement : "狐".
  kanji String?
  /// Surtitre de la carte : "Tromperie", "Mobilité"…
  role  String

  /// Une ou deux phrases, affichées sur la carte de la grille /kits.
  descriptionCourte String
  /// Texte long en Markdown, affiché sur la page /kits/[slug].
  descriptionLongue String @db.Text

  /// Prix en coins gagnés en jeu. 0 = offert.
  prixCoins         Int  @default(0)
  /// Prix en euros, en CENTIMES (400 = 4 €). null = pas de prix en euros.
  /// Les centimes évitent les arrondis flottants et sont déjà le format
  /// attendu par les prestataires de paiement en phase 2.
  prixEurosCentimes Int?

  type TypeKit @default(GRATUIT)

  /// Affiché sur le site public. false = brouillon, visible en admin seulement.
  visible     Boolean @default(true)
  /// Proposé à l'achat en euros (boutique, phase 2).
  achetable   Boolean @default(false)
  /// Badge "Bientôt disponible" : le kit est annoncé mais pas encore jouable.
  bientot     Boolean @default(false)
  /// Badge "Kit de départ" : offert à l'arrivée sur le serveur.
  /// Champ à part et non déduit de prixCoins, pour pouvoir offrir un kit
  /// temporairement (événement) sans le faire passer pour un kit de départ.
  kitDeDepart Boolean @default(false)

  /// Position dans la grille. Réglée par les boutons ↑ / ↓ de l'admin.
  /// Volontairement sans contrainte d'unicité : l'échange de deux positions
  /// se fait en une transaction, sans valeur temporaire.
  ordre Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Identifiant numérique du package correspondant chez Tebex.
  /// Obligatoire pour qu'un article achetable puisse entrer dans un panier.
  tebexPackageId Int? @unique

  caracteristiques CaracteristiqueKit[]
  packs            Pack[]
  lignesCommande   LigneCommande[]

  @@index([visible, ordre])
  @@index([ordre])
}

/// Une ligne de la fiche technique d'un kit : "Cooldown" / "3 s".
model CaracteristiqueKit {
  id      String @id @default(cuid())
  kitId   String
  libelle String
  valeur  String
  ordre   Int

  kit Kit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@index([kitId, ordre])
}

/// Le règlement est une simple liste de sections ordonnées.
/// Pas de table "Reglement" englobante : la date de dernière mise à jour
/// affichée côté public est le max(updatedAt) des sections publiées.
model SectionReglement {
  id      String  @id @default(cuid())
  /// Titre de la section : "Triche — tolérance zéro".
  titre   String
  /// Corps de la section, en Markdown.
  contenu String  @db.Text
  /// Position dans la page, sert aussi de numéro affiché (1, 2, 3…).
  ordre   Int
  /// false = brouillon : la section reste invisible côté public.
  publie  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publie, ordre])
}

/// Un seul compte. Pas de champ "role" : être dans cette table suffit.
model Admin {
  id             String   @id @default(cuid())
  email          String   @unique
  motDePasseHash String
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// BOUTIQUE (phase 2)
//
// Trois choses à vendre — un grade, un kit exclusif, un pack — et les
// commandes qui en découlent. Tous les prix sont en CENTIMES entiers.
// ---------------------------------------------------------------------------

/// Un rang cosmétique acheté à vie : préfixe, couleur, rôle Discord.
/// Aucun avantage en combat, c'est la promesse affichée sur la boutique.
model Grade {
  id String @id @default(cuid())

  /// Identifiant stable, sert de clé au panier et au seed.
  slug      String  @unique
  /// "Ronin"
  nom       String
  /// Idéogramme décoratif : "浪人".
  kanji     String?
  /// Glose française affichée après le kanji : "le sans-maître".
  sousTitre String?
  /// Bandeau de mise en avant, ex : "Le plus pris".
  /// null = carte normale ; du texte = carte mise en avant avec ce libellé.
  etiquette String?

  prixEurosCentimes Int

  ordre     Int
  visible   Boolean @default(true)
  achetable Boolean @default(true)

  /// Affiche "↳ Tout le grade X" en tête des avantages. X est déduit du grade
  /// qui précède dans l'ordre : pas de champ de liaison à maintenir.
  heriteDuPrecedent Boolean @default(false)

  /// Identifiant numérique du package correspondant chez Tebex.
  tebexPackageId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avantages      AvantageGrade[]
  lignesCommande LigneCommande[]

  @@index([visible, ordre])
  @@index([ordre])
}

/// Une ligne de la liste d'avantages d'un grade.
model AvantageGrade {
  id      String @id @default(cuid())
  gradeId String
  texte   String
  ordre   Int

  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@index([gradeId, ordre])
}

/// Un lot de kits vendu à prix réduit.
model Pack {
  id String @id @default(cuid())

  slug        String @unique
  nom         String
  description String

  prixEurosCentimes Int
  /// Prix affiché barré à côté du prix réel. null = pas de prix barré.
  prixBarreCentimes Int?

  ordre     Int
  visible   Boolean @default(true)
  achetable Boolean @default(true)

  /// Identifiant numérique du package correspondant chez Tebex.
  tebexPackageId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relation implicite : Prisma gère la table de jointure. Suffisant tant
  /// qu'on n'a besoin ni d'ordonner ni d'annoter les kits d'un pack.
  kits Kit[]

  lignesCommande LigneCommande[]

  @@index([visible, ordre])
  @@index([ordre])
}

/// Cycle de vie d'une commande.
/// EN_ATTENTE : créée sur le site, pas encore payée.
/// PAYEE      : le prestataire a confirmé le paiement (webhook, phase 3).
/// LIVREE     : le contenu a été appliqué sur le compte du joueur.
/// ECHOUEE    : paiement refusé, abandonné, ou panier Tebex non créé.
/// REMBOURSEE : remboursement effectué, ou litige perdu.
/// LITIGE     : litige ouvert par le client, en cours d'arbitrage. La commande
///              a le plus souvent déjà été livrée — `livreeAt` reste posé,
///              c'est lui qui permet de le savoir.
enum StatutCommande {
  EN_ATTENTE
  PAYEE
  LIVREE
  ECHOUEE
  REMBOURSEE
  LITIGE
}

enum TypeArticle {
  KIT
  GRADE
  PACK
}

model Commande {
  /// Identifiant non devinable : c'est lui qui sert d'URL de confirmation.
  id String @id @default(cuid())

  /// Numéro lisible, affiché au client et utilisé au support : LJK-000042.
  /// Séquentiel, donc jamais mis dans une URL — ce serait énumérable.
  numero Int @unique @default(autoincrement())

  /// Pseudo Minecraft de livraison, saisi par l'acheteur.
  pseudoMinecraft String

  /// Total recalculé côté serveur à partir des prix en base, jamais depuis
  /// ce que le navigateur a envoyé.
  montantTotalCentimes Int

  statut StatutCommande @default(EN_ATTENTE)

  /// Ident du panier Tebex, posé à la création de la commande.
  /// Unique, et c'est par lui qu'on retrouve la commande si le `custom` du
  /// webhook venait à manquer.
  referenceExterne String? @unique

  /// Id de transaction Tebex ("tbx-…"), posé par le webhook de paiement.
  /// C'est ce que le client voit sur son relevé et cite au support.
  transactionTebex String?

  /// Dernière erreur technique rencontrée (création du panier Tebex, webhook).
  /// Affichée dans l'admin : une commande qui échoue ne doit pas le faire
  /// en silence.
  derniereErreur String?

  createdAt DateTime  @default(now())
  payeeAt   DateTime?
  livreeAt  DateTime?

  lignes LigneCommande[]

  @@index([statut, createdAt])
  /// Sert au garde-fou anti-abus : compter les commandes non payées d'un
  /// même pseudo sur la dernière heure.
  @@index([pseudoMinecraft, statut, createdAt])
}

model LigneCommande {
  id         String      @id @default(cuid())
  commandeId String
  type       TypeArticle

  /// Un seul des trois est renseigné, selon `type`.
  kitId   String?
  gradeId String?
  packId  String?

  /// Instantanés pris AU MOMENT de l'achat. C'est ce qui permet de supprimer
  /// ou de repricer un article dans l'admin sans réécrire l'historique.
  libelle      String
  prixCentimes Int

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  kit      Kit?     @relation(fields: [kitId], references: [id], onDelete: SetNull)
  grade    Grade?   @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  pack     Pack?    @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@index([commandeId])
}

/// Journal des webhooks Tebex déjà traités.
///
/// C'est le mécanisme d'idempotence : `id` est l'identifiant du webhook fourni
/// par Tebex. On insère AVANT de traiter ; si l'insertion viole la contrainte
/// de clé primaire, l'évènement a déjà été traité et on répond 200 sans rien
/// refaire. Une même commande reçoit plusieurs évènements légitimes
/// (completed, puis refunded…), ce qu'un simple champ unique sur Commande
/// n'aurait pas su distinguer.
model EvenementTebex {
  id         String   @id
  type       String
  commandeId String?
  recuLe     DateTime @default(now())

  @@index([commandeId])
}

// ---------------------------------------------------------------------------
// ⚠⚠⚠  TABLE EXTERNE — NE JAMAIS MODIFIER NI SUPPRIMER  ⚠⚠⚠
//
// `joueur` appartient au SERVEUR MINECRAFT. Elle est créée et alimentée par
// skript-db, pas par Prisma. Le site ne fait que la LIRE (classements,
// statistiques, solde de coins).
//
// Elle est déclarée ici pour une seule raison : `prisma db push` SUPPRIME
// toute table de la base qui n'apparaît pas dans ce fichier. Sans ce modèle,
// la table et ses données disparaissent au prochain push.
//
// RÈGLES :
//   1. Ne change aucun champ, aucun type, aucune valeur par défaut. Toute
//      divergence ferait proposer un ALTER TABLE par db push — c'est-à-dire
//      une modification d'une table dont le serveur Minecraft est propriétaire.
//   2. N'écris jamais dedans depuis le site. Aucune Server Action, aucune
//      route ne doit faire de create/update/delete sur ce modèle.
//   3. Si skript-db fait évoluer la table, refais une introspection
//      (`npx prisma db pull` dans un fichier à part) et recopie le résultat
//      ici À L'IDENTIQUE.
//
// La structure ci-dessous est le résultat exact d'une introspection Prisma
// de la vraie table : types, précision du timestamp et valeurs par défaut
// compris. Vérifié avec `npm run db:diff` : aucune modification proposée.
// ---------------------------------------------------------------------------
model Joueur {
  /// UUID Minecraft du joueur, tel que le serveur l'écrit.
  uuid   String @id
  pseudo String

  kills  Int @default(0)
  morts  Int @default(0)
  points Int @default(0)
  coins  Int @default(0)

  recordSerie   Int @default(0) @map("record_serie")
  hebdoPoints   Int @default(0) @map("hebdo_points")
  mensuelPoints Int @default(0) @map("mensuel_points")

  /// timestamptz(6) côté PostgreSQL : la précision doit rester explicite,
  /// sinon Prisma proposerait de la ramener à 3.
  derniereMaj DateTime @default(now()) @map("derniere_maj") @db.Timestamptz(6)

  // Index créés par skript-db pour les classements. `map:` reprend leur nom
  // exact et `sort: Desc` leur sens : sans ces trois lignes, db push les
  // SUPPRIMERAIT, et les requêtes de classement du serveur passeraient en
  // parcours complet de table sans que rien ne le signale.
  @@index([kills(sort: Desc)], map: "idx_kills")
  @@index([hebdoPoints(sort: Desc)], map: "idx_hebdo")
  @@index([mensuelPoints(sort: Desc)], map: "idx_mensuel")
  @@map("joueur")
}

/// Dates de remise à zéro des classements.
///
/// Table créée par Prisma (elle est dans les migrations) mais ÉCRITE par le
/// SERVEUR MINECRAFT, en SQL brut : c'est lui qui sait quand il remet les
/// compteurs à zéro. Le site ne fait que la lire.
///
/// Le @@map en snake_case n'est pas cosmétique : sans lui, PostgreSQL rendrait
/// le nom sensible à la casse et skript-db devrait écrire
/// `INSERT INTO "ConfigClassement"` avec les guillemets. Là, un simple
/// `INSERT INTO config_classement (cle, valeur) VALUES ('hebdo_fin', 1755648000)`
/// suffit.
model ConfigClassement {
  /// "hebdo_fin" ou "mensuel_fin".
  cle String @id

  /// Timestamp unix en SECONDES de la prochaine remise à zéro.
  /// BigInt côté base ; converti en Number avant d'être envoyé au composant
  /// client, qui ne saurait pas sérialiser un BigInt.
  valeur BigInt

  @@map("config_classement")
}

/// Les réglages du site, modifiables depuis l'admin.
///
/// Tout ce qui change au fil du temps sans mériter un déploiement : l'adresse
/// du serveur, le lien Discord, les URL de vote. Avant, c'était en dur dans
/// src/lib/site.ts — donc chaque changement demandait une modification de code.
///
/// Table à UNE SEULE LIGNE, d'id 1. On l'upserte toujours sur cet id : pas de
/// création accidentelle d'une seconde ligne de réglages qui ne servirait
/// jamais. Si la ligne n'existe pas, le site retombe sur les valeurs par défaut
/// de src/lib/site.ts plutôt que de planter.
model Reglages {
  id Int @id @default(1)

  /// Adresse du serveur Minecraft, affichée et copiée partout.
  ip String

  /// Invitation Discord. Reprise aussi dans le règlement via {discord}.
  discord String

  /// URL de vote. Vide = le serveur n'est pas encore inscrit sur ce site,
  /// le bouton reste affiché mais inerte.
  urlServeurPrive      String @default("")
  urlTopServeurs       String @default("")
  urlServeursMinecraft String @default("")

  /// Le recrutement staff accepte-t-il des candidatures ?
  ///
  /// FAUX PAR DÉFAUT, et peuplerReglages() ne touche jamais une ligne de
  /// réglages déjà présente : ni une migration, ni un déploiement, ni un seed
  /// ne peut ouvrir le recrutement. Seul un clic dans /admin/recrutement le
  /// peut.
  recrutementOuvert Boolean @default(false)

  /// Ce que lit un visiteur qui ouvre /recrutement quand c'est fermé.
  /// Un message, jamais un 404 : le lien vient d'être partagé à la main, et
  /// une page introuvable donnerait l'impression d'un site cassé.
  recrutementMessageFerme String @default("Le recrutement est fermé pour le moment. Les ouvertures sont annoncées sur le Discord — passe y jeter un œil.") @db.Text

  updatedAt DateTime @updatedAt

  @@map("reglages")
}

// ---------------------------------------------------------------------------
// AUDIENCE
//
// Suivi maison des pages vues, pour /admin/stats. Volontairement minimal :
// aucune adresse IP, aucun user-agent, aucun cookie. Un identifiant de visite
// anonyme, tiré au hasard et rangé dans le sessionStorage du navigateur, suffit
// à distinguer deux visiteurs sans jamais identifier personne.
//
// Les pages /admin ne sont jamais enregistrées : ce sont les tiennes, elles
// fausseraient les chiffres.
// ---------------------------------------------------------------------------

/// Le type d'appareil, déduit côté client de la largeur et du pointeur.
enum TypeAppareil {
  MOBILE
  TABLETTE
  BUREAU
}

model VuePage {
  id String @id @default(cuid())

  /// Chemin réel visité : "/", "/kits/kitsune", "/boutique"…
  /// Sans query string : elle n'apporte rien et peut contenir n'importe quoi.
  chemin String

  /// Identifiant de visite anonyme, constant le temps d'un onglet.
  /// C'est lui qui permet de compter des VISITEURS et pas seulement des vues.
  visiteId String

  /// Temps passé sur la page, en millisecondes. `null` tant que le visiteur
  /// n'a pas quitté la page — une vue sans durée est une page encore ouverte,
  /// ou un départ que le navigateur n'a pas eu le temps de signaler.
  dureeMs Int?

  /// Domaine de provenance ("google.com"), jamais l'URL complète.
  /// `null` = accès direct, ou navigation interne au site.
  source String?

  appareil TypeAppareil

  createdAt DateTime @default(now())

  /// Les trois lectures de l'audience : par période, par page, par visiteur.
  /// L'index sur createdAt sert aussi la purge de rétention (< 180 jours) et
  /// l'agrégation quotidienne du cron de maintenance : sans lui, elles
  /// passeraient en parcours complet dès quelques dizaines de milliers de vues.
  @@index([createdAt])
  @@index([chemin, createdAt])
  @@index([visiteId])
}

/// Agrégat quotidien de l'audience.
///
/// Calculé par le cron de maintenance (cf. /api/cron/maintenance) AVANT la
/// purge des VuePage de plus de 180 jours : on garde ainsi un historique long
/// et bon marché sans conserver des millions de lignes fines. Une ligne par
/// jour, le jour étant fixé à minuit dans le fuseau Europe/Paris.
model StatistiqueJour {
  /// Le jour concerné, à minuit Europe/Paris. Type DATE : pas d'heure.
  jour DateTime @id @db.Date

  vues           Int
  /// Visiteurs distincts (visiteId) ce jour-là.
  visiteurs      Int
  /// Temps moyen passé, en millisecondes, sur les vues qui avaient une durée.
  /// null si aucune vue du jour n'a pu être mesurée jusqu'à sa sortie.
  dureeMoyenneMs Int?

  @@map("statistique_jour")
}

// ---------------------------------------------------------------------------
// FRÉQUENTATION
//
// Historique du nombre de joueurs connectés. Alimenté depuis le VPS (le bot
// Discord relié au serveur en RCON) qui POST sur /api/frequentation toutes les
// dix minutes : la donnée vient donc directement du serveur, sans dépendre de
// mcstatus.io ni d'un plan Vercel payant.
//
// Une donnée non collectée est perdue pour toujours : la collecte démarre dès
// la mise en ligne, même si le graphique de fréquentation viendra plus tard.
// ---------------------------------------------------------------------------

model EchantillonFrequentation {
  id String @id @default(cuid())

  /// Instant du relevé.
  releveLe DateTime @default(now())

  /// Le serveur répondait-il à cet instant ?
  /// On enregistre un point dans les DEUX cas : hors ligne = { enLigne: false,
  /// joueurs: 0 }. C'est ce booléen qui distingue un serveur éteint (une ligne
  /// à false) d'un collecteur en panne (aucune ligne du tout) — impossible à
  /// reconstituer après coup, d'où sa présence dès le départ.
  enLigne Boolean

  /// Joueurs connectés à cet instant. 0 quand le serveur est hors ligne.
  joueurs Int

  /// Capacité annoncée par le serveur (slots), pour tracer un plafond.
  maxJoueurs Int

  @@index([releveLe])
  @@map("echantillon_frequentation")
}

// ---------------------------------------------------------------------------
// RECRUTEMENT STAFF
//
// Un formulaire de candidature accessible par lien direct uniquement
// (/recrutement, en noindex, jamais lié depuis le site), dont les QUESTIONS
// SONT EN BASE et non dans le code : elles s'ajoutent, se modifient, se
// réordonnent et se désactivent depuis /admin/recrutement.
//
// Le principe qui gouverne tout ce bloc : une candidature déjà reçue ne doit
// JAMAIS devenir illisible parce que le questionnaire a changé après coup.
// D'où `ReponseCandidature`, qui est une PHOTOGRAPHIE (libellé, type, section
// et rang figés à l'envoi) et non une simple clé étrangère. L'affichage d'une
// candidature ne relit jamais `QuestionRecrutement` : il se suffit à lui-même.
// ---------------------------------------------------------------------------

/// Les types de champ proposés à l'admin.
/// TEXTE_COURT  : <input type="text">, une ligne.
/// TEXTE_LONG   : <textarea>, c'est le type des mises en situation.
/// NOMBRE       : entier, bornes dans `minimum` / `maximum`.
/// OUI_NON      : deux boutons radio, stockés "oui" / "non".
/// CHOIX_UNIQUE : une option parmi `options`, validée côté serveur.
enum TypeQuestion {
  TEXTE_COURT
  TEXTE_LONG
  NOMBRE
  OUI_NON
  CHOIX_UNIQUE
}

/// EN_ATTENTE : reçue, pas encore traitée.
/// ACCEPTEE   : le candidat rejoint le staff.
/// REFUSEE    : c'est `decideeAt` qui fait alors courir le délai de carence.
enum StatutCandidature {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

/// Un intertitre du formulaire : "Identité", "Mises en situation"…
/// Administrable comme les questions : renommable, réordonnable, désactivable.
model SectionRecrutement {
  id  String @id @default(cuid())
  nom String

  /// Position de la section dans le formulaire.
  ordre Int

  /// false = la section ET toutes ses questions disparaissent du formulaire
  /// public, sans rien supprimer.
  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuestionRecrutement[]

  @@index([actif, ordre])
  @@index([ordre])
}

/// Une question du formulaire.
model QuestionRecrutement {
  id        String @id @default(cuid())
  sectionId String

  /// L'intitulé lu par le candidat : "Qu'est-ce que le soup PvP pour toi ?".
  libelle String @db.Text

  /// Texte d'aide affiché SOUS le champ. Optionnel.
  aide String? @db.Text

  type TypeQuestion @default(TEXTE_COURT)

  /// Les choix proposés, pour CHOIX_UNIQUE uniquement. Vide ailleurs.
  /// Le schéma zod du formulaire public est construit à partir de CETTE
  /// liste : une option forgée par le navigateur est rejetée.
  options String[] @default([])

  obligatoire Boolean @default(true)

  /// Un seul couple de bornes pour trois usages, selon `type` :
  ///   TEXTE_COURT / TEXTE_LONG → un NOMBRE DE CARACTÈRES (les 200 caractères
  ///                              minimum des mises en situation, par exemple) ;
  ///   NOMBRE                   → une VALEUR ;
  ///   OUI_NON / CHOIX_UNIQUE   → ignorées.
  /// Deux champs plutôt que quatre : c'est l'admin qui étiquette la saisie
  /// selon le type choisi — jamais un « Minimum » nu, cf. uniteDesBornes()
  /// dans src/lib/recrutement.ts. Quoi qu'il y ait ici, le serveur applique en
  /// plus un plafond dur par champ.
  minimum Int?
  maximum Int?

  /// Position DANS SA SECTION. Réordonné par les boutons ↑ / ↓, comme les
  /// kits et les sections de règlement : pas de contrainte d'unicité, la
  /// permutation se fait en une transaction.
  ordre Int

  /// false = retirée du formulaire, conservée en base.
  ///
  /// C'est l'état dans lequel bascule une question qu'on « supprime » alors
  /// que des candidatures y ont déjà répondu : la Server Action refuse le
  /// DELETE et désactive à la place (cf. src/actions/recrutement.ts).
  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Restrict et non Cascade : supprimer une section ne doit pas emporter
  /// silencieusement ses questions, donc l'historique qui s'y rattache.
  section  SectionRecrutement   @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  reponses ReponseCandidature[]

  @@index([sectionId, ordre])
  @@index([actif, ordre])
}

/// Une candidature reçue.
///
/// Les trois champs d'identité (pseudo Minecraft, pseudo Discord, âge) sont
/// des COLONNES et non des questions administrables. Ils portent des règles
/// métier — délai de carence, limitation de débit, affichage de la liste, mise
/// en évidence dans l'embed Discord, âge minimum — qu'un clic malheureux dans
/// l'admin (désactivation, changement de type, suppression) casserait
/// silencieusement. Tout le reste du formulaire est administrable.
model Candidature {
  /// Identifiant non devinable : c'est lui qui sert d'URL de fiche en admin.
  id String @id @default(cuid())

  /// Numéro lisible, cité au candidat et sur Discord : #000042.
  numero Int @unique @default(autoincrement())

  /// Validé par le même regex que la boutique : 3 à 16 caractères, [A-Za-z0-9_].
  pseudoMinecraft String
  /// Pour que le chef staff puisse prendre le relais avec le candidat.
  pseudoDiscord   String
  /// Entier. Le minimum de 16 ans est appliqué côté serveur.
  age             Int

  statut StatutCandidature @default(EN_ATTENTE)

  /// Notes internes du staff sur ce candidat. Jamais montrées ailleurs.
  noteAdmin String? @db.Text

  /// Instant du passage à ACCEPTEE ou REFUSEE. C'est de LUI que part le délai
  /// de carence de 30 jours après un refus, et non de `createdAt` : le délai
  /// doit courir à partir de la décision, pas de l'envoi.
  decideeAt DateTime?

  /// Consentement RGPD. Le TEXTE est figé, pas seulement la date : si la
  /// formulation change un jour, on saura toujours à quoi chaque candidat a
  /// consenti.
  consentementAt    DateTime
  consentementTexte String   @db.Text

  /// Suivi de la notification Discord. `webhookEnvoyeAt` null + `webhookErreur`
  /// renseigné = la candidature est bien en base mais n'est pas partie sur
  /// Discord ; l'admin l'affiche et propose un renvoi. Une candidature n'est
  /// jamais perdue à cause de Discord.
  webhookEnvoyeAt DateTime?
  webhookErreur   String?

  createdAt DateTime @default(now())

  /// La corbeille. null = candidature vivante.
  ///
  /// Le CASCADE sur les réponses rend un vrai DELETE irréversible : il emporte
  /// des réponses écrites par une personne réelle, sous un consentement figé.
  /// La mise à la corbeille est donc l'opération courante, réversible d'un
  /// clic ; la suppression définitive reste possible depuis la corbeille, mais
  /// derrière une confirmation en deux temps (il faut retaper le pseudo du
  /// candidat). Elle doit rester accessible : un candidat qui demande
  /// l'effacement de ses données a droit à un vrai DELETE, pas à un drapeau.
  ///
  /// ⚠ UNE LECTURE IGNORE CE CHAMP, DÉLIBÉRÉMENT : le délai de carence
  /// (cf. verifierEligibilite() dans src/lib/limite.ts). Sinon, ranger sa boîte
  /// de réception rouvrirait la porte à un candidat refusé la veille.
  ///
  /// Le cron de maintenance purge la corbeille au bout de 30 jours, et toutes
  /// les candidatures au bout de 6 mois — la durée annoncée au candidat.
  supprimeeAt DateTime?

  reponses ReponseCandidature[]

  @@index([statut, createdAt])
  /// Sert la liste (qui exclut la corbeille) et la purge de la corbeille.
  @@index([supprimeeAt, createdAt])
  /// Sert au délai de carence et au blocage d'une candidature déjà en cours.
  /// La comparaison se fait en `mode: 'insensitive'` (Lestoo == lestoo), ce que
  /// PostgreSQL ne peut pas servir par cet index : à l'échelle attendue
  /// (quelques centaines de lignes) le parcours est sans conséquence, et un
  /// index fonctionnel sur lower() serait de l'optimisation prématurée.
  @@index([pseudoMinecraft, createdAt])
  /// Purge des candidatures de plus de 6 mois par le cron de maintenance.
  @@index([createdAt])
}

/// Une réponse, figée au moment de l'envoi.
///
/// TOUT ce qu'il faut pour afficher la ligne est ici : le libellé, le type, le
/// nom de la section et le rang. Les questions peuvent être renommées,
/// retypées, réordonnées, désactivées ou supprimées ensuite — la fiche reste
/// exactement telle que le candidat l'a remplie.
///
/// Une ligne est écrite pour CHAQUE question active à l'envoi, MÊME SANS
/// RÉPONSE (`valeur` vide). C'est ce qui distingue « on lui a posé la
/// question, il n'a pas répondu » de « la question n'existait pas encore » —
/// et c'est ce qui fait qu'ajouter une obligation après coup n'a aucun effet
/// rétroactif : l'obligation est vérifiée à l'ENVOI, jamais à la lecture.
model ReponseCandidature {
  id            String @id @default(cuid())
  candidatureId String

  /// Conservé pour l'analyse (regrouper les réponses d'une même question) et
  /// pour afficher un repère « question supprimée depuis » quand il vaut null.
  /// N'entre JAMAIS dans le rendu de la fiche.
  questionId String?

  /// La photographie.
  libelleFige  String       @db.Text
  typeFige     TypeQuestion
  sectionFigee String

  /// Rang ABSOLU dans le formulaire tel qu'il a été affiché (0, 1, 2…), toutes
  /// sections confondues. Trier là-dessus restitue l'ordre exact que le
  /// candidat a vu, même si les questions ont été réordonnées depuis.
  ordreFige Int

  /// Forme canonique, quel que soit le type : "oui" / "non" pour OUI_NON,
  /// l'entier en décimal pour NOMBRE, le libellé de l'option pour
  /// CHOIX_UNIQUE. C'est `typeFige` qui commande le rendu.
  valeur String @db.Text

  candidature Candidature          @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  question    QuestionRecrutement? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([candidatureId, ordreFige])
  @@index([questionId])
}

/// Compteur de la limitation de débit du formulaire public.
///
/// Une ligne par TENTATIVE (acceptée ou refusée), volontairement séparée de
/// `Candidature` : une tentative rejetée doit compter, sinon un script refusé
/// pourrait réessayer sans fin.
///
/// `empreinte` ne contient JAMAIS d'adresse IP en clair : c'est
/// "ip:<sha256(ip + AUTH_SECRET)>" ou "pseudo:<pseudo en minuscules>". Le
/// compteur global de l'heure se lit en comptant les empreintes "ip:".
/// Purgée à 7 jours par le cron de maintenance : au-delà, plus aucune fenêtre
/// ne s'en sert.
model TentativeRecrutement {
  id        String   @id @default(cuid())
  empreinte String
  createdAt DateTime @default(now())

  @@index([empreinte, createdAt])
  @@index([createdAt])
}

/* ══════════════════════════════════════════════════════════════════════════
   LE CLASSEMENT ELO

   Quatre tables CRÉÉES À LA MAIN dans la console Neon et ÉCRITES par le
   plugin LJElo. Le site n'en fait que des lectures.

   POURQUOI ELLES SONT DÉCLARÉES ICI ALORS QUE PRISMA NE LES A PAS CRÉÉES.
   Prisma ne connaît que ce que ce fichier décrit. Une table absente du
   schéma est, pour lui, une table à supprimer : le premier `db push` les
   aurait effacées avec toute la saison en cours — exactement ce qui était
   arrivé à la table `joueur`. Les déclarer, c'est les protéger.

   Les `@@map`, `@map` et noms d'index reprennent EXACTEMENT le SQL du
   plugin (LJElo/sql/schema-elo.sql). Le moindre écart ferait proposer à
   Prisma un renommage, donc une migration destructrice.
   ══════════════════════════════════════════════════════════════════════════ */

/// Une saison de classement. Le plugin en ouvre une par mois.
model EloSaison {
  id     Int       @id @default(autoincrement())
  nom    String
  debut  DateTime  @db.Timestamptz(6)
  /// Nulle tant que la saison est en cours.
  fin    DateTime? @db.Timestamptz(6)
  statut String    @default("en_cours")

  @@map("elo_saison")
}

/// L'état d'un joueur pour une saison donnée. Clé composée : un même joueur
/// a une ligne par saison, et les saisons passées restent consultables.
model EloJoueur {
  uuid   String
  saison Int
  pseudo String

  elo    Int
  eloMax Int @map("elo_max")

  combats     Int @default(0)
  kills       Int @default(0)
  morts       Int @default(0)
  serie       Int @default(0)
  recordSerie Int @default(0) @map("record_serie")

  derniereMaj DateTime @default(now()) @map("derniere_maj") @db.Timestamptz(6)

  @@id([uuid, saison])
  // Index du classement : sans lui, chaque affichage du top ferait un
  // parcours complet de table. Le `map:` reprend son nom côté base.
  @@index([saison, elo(sort: Desc)], map: "idx_joueur_classement")
  @@map("elo_joueur")
}

/// Un combat. Une ligne par kill, avec les deux kits et l'Elo avant/après :
/// c'est ce qui alimente l'historique et les fiches joueur.
model EloMatch {
  id      BigInt   @id @default(autoincrement())
  saison  Int
  instant DateTime @default(now()) @db.Timestamptz(6)

  tueur         String
  tueurPseudo   String @map("tueur_pseudo")
  victime       String
  victimePseudo String @map("victime_pseudo")

  kitTueur   String? @map("kit_tueur")
  kitVictime String? @map("kit_victime")

  eloTueurAvant   Int @map("elo_tueur_avant")
  eloTueurApres   Int @map("elo_tueur_apres")
  eloVictimeAvant Int @map("elo_victime_avant")
  eloVictimeApres Int @map("elo_victime_apres")

  gain  Int
  perte Int

  /// Points de vie restants au tueur. Nul si la mesure a échoué.
  pvRestants  Float? @map("pv_restants")
  /// Coefficient anti-farm appliqué au combat : 1 = plein, 0 = neutralisé.
  facteurFarm Float  @default(1) @map("facteur_farm")

  @@index([saison, instant(sort: Desc)], map: "idx_match_saison_instant")
  @@index([tueur, instant(sort: Desc)], map: "idx_match_tueur")
  @@index([victime, instant(sort: Desc)], map: "idx_match_victime")
  @@map("elo_match")
}

/// La liaison Discord. C'est elle qui rend un joueur CLASSABLE : le plugin
/// comme le site excluent du classement les comptes non liés.
model EloLiaison {
  uuid          String   @id
  discordId     String   @map("discord_id")
  pseudoDiscord String?  @map("pseudo_discord")
  lieeLe        DateTime @default(now()) @map("liee_le") @db.Timestamptz(6)

  @@map("elo_liaison")
}
