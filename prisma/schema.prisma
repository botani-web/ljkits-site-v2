// ---------------------------------------------------------------------------
// Schéma de la base LJKITS.
// Quatre domaines : les kits, le règlement, le compte admin, et la boutique
// (grades, packs, commandes).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Les deux familles de kits.
/// GRATUIT  : kit classique, se débloque en coins gagnés en jouant.
/// EXCLUSIF : kit maison, se débloque en coins AUSSI, mais peut être
///            proposé à l'achat en euros pour raccourcir le grind (phase 2).
enum TypeKit {
  GRATUIT
  EXCLUSIF
}

model Kit {
  id String @id @default(cuid())

  /// Identifiant dans l'URL : /kits/kitsune. Modifiable depuis l'admin.
  slug  String  @unique
  /// Nom affiché : "Kitsune".
  nom   String
  /// Idéogramme décoratif, kits exclusifs uniquement : "狐".
  kanji String?
  /// Surtitre de la carte : "Tromperie", "Mobilité"…
  role  String

  /// Une ou deux phrases, affichées sur la carte de la grille /kits.
  descriptionCourte String
  /// Texte long en Markdown, affiché sur la page /kits/[slug].
  descriptionLongue String @db.Text

  /// Prix en coins gagnés en jeu. 0 = offert.
  prixCoins         Int  @default(0)
  /// Prix en euros, en CENTIMES (400 = 4 €). null = pas de prix en euros.
  /// Les centimes évitent les arrondis flottants et sont déjà le format
  /// attendu par les prestataires de paiement en phase 2.
  prixEurosCentimes Int?

  type TypeKit @default(GRATUIT)

  /// Affiché sur le site public. false = brouillon, visible en admin seulement.
  visible     Boolean @default(true)
  /// Proposé à l'achat en euros (boutique, phase 2).
  achetable   Boolean @default(false)
  /// Badge "Bientôt disponible" : le kit est annoncé mais pas encore jouable.
  bientot     Boolean @default(false)
  /// Badge "Kit de départ" : offert à l'arrivée sur le serveur.
  /// Champ à part et non déduit de prixCoins, pour pouvoir offrir un kit
  /// temporairement (événement) sans le faire passer pour un kit de départ.
  kitDeDepart Boolean @default(false)

  /// Position dans la grille. Réglée par les boutons ↑ / ↓ de l'admin.
  /// Volontairement sans contrainte d'unicité : l'échange de deux positions
  /// se fait en une transaction, sans valeur temporaire.
  ordre Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Identifiant numérique du package correspondant chez Tebex.
  /// Obligatoire pour qu'un article achetable puisse entrer dans un panier.
  tebexPackageId Int? @unique

  caracteristiques CaracteristiqueKit[]
  packs            Pack[]
  lignesCommande   LigneCommande[]

  @@index([visible, ordre])
  @@index([ordre])
}

/// Une ligne de la fiche technique d'un kit : "Cooldown" / "3 s".
model CaracteristiqueKit {
  id      String @id @default(cuid())
  kitId   String
  libelle String
  valeur  String
  ordre   Int

  kit Kit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@index([kitId, ordre])
}

/// Le règlement est une simple liste de sections ordonnées.
/// Pas de table "Reglement" englobante : la date de dernière mise à jour
/// affichée côté public est le max(updatedAt) des sections publiées.
model SectionReglement {
  id      String  @id @default(cuid())
  /// Titre de la section : "Triche — tolérance zéro".
  titre   String
  /// Corps de la section, en Markdown.
  contenu String  @db.Text
  /// Position dans la page, sert aussi de numéro affiché (1, 2, 3…).
  ordre   Int
  /// false = brouillon : la section reste invisible côté public.
  publie  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publie, ordre])
}

/// Un seul compte. Pas de champ "role" : être dans cette table suffit.
model Admin {
  id             String   @id @default(cuid())
  email          String   @unique
  motDePasseHash String
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// BOUTIQUE (phase 2)
//
// Trois choses à vendre — un grade, un kit exclusif, un pack — et les
// commandes qui en découlent. Tous les prix sont en CENTIMES entiers.
// ---------------------------------------------------------------------------

/// Un rang cosmétique acheté à vie : préfixe, couleur, rôle Discord.
/// Aucun avantage en combat, c'est la promesse affichée sur la boutique.
model Grade {
  id String @id @default(cuid())

  /// Identifiant stable, sert de clé au panier et au seed.
  slug      String  @unique
  /// "Ronin"
  nom       String
  /// Idéogramme décoratif : "浪人".
  kanji     String?
  /// Glose française affichée après le kanji : "le sans-maître".
  sousTitre String?
  /// Bandeau de mise en avant, ex : "Le plus pris".
  /// null = carte normale ; du texte = carte mise en avant avec ce libellé.
  etiquette String?

  prixEurosCentimes Int

  ordre     Int
  visible   Boolean @default(true)
  achetable Boolean @default(true)

  /// Affiche "↳ Tout le grade X" en tête des avantages. X est déduit du grade
  /// qui précède dans l'ordre : pas de champ de liaison à maintenir.
  heriteDuPrecedent Boolean @default(false)

  /// Identifiant numérique du package correspondant chez Tebex.
  tebexPackageId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avantages      AvantageGrade[]
  lignesCommande LigneCommande[]

  @@index([visible, ordre])
  @@index([ordre])
}

/// Une ligne de la liste d'avantages d'un grade.
model AvantageGrade {
  id      String @id @default(cuid())
  gradeId String
  texte   String
  ordre   Int

  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@index([gradeId, ordre])
}

/// Un lot de kits vendu à prix réduit.
model Pack {
  id String @id @default(cuid())

  slug        String @unique
  nom         String
  description String

  prixEurosCentimes Int
  /// Prix affiché barré à côté du prix réel. null = pas de prix barré.
  prixBarreCentimes Int?

  ordre     Int
  visible   Boolean @default(true)
  achetable Boolean @default(true)

  /// Identifiant numérique du package correspondant chez Tebex.
  tebexPackageId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relation implicite : Prisma gère la table de jointure. Suffisant tant
  /// qu'on n'a besoin ni d'ordonner ni d'annoter les kits d'un pack.
  kits Kit[]

  lignesCommande LigneCommande[]

  @@index([visible, ordre])
  @@index([ordre])
}

/// Cycle de vie d'une commande.
/// EN_ATTENTE : créée sur le site, pas encore payée.
/// PAYEE      : le prestataire a confirmé le paiement (webhook, phase 3).
/// LIVREE     : le contenu a été appliqué sur le compte du joueur.
/// ECHOUEE    : paiement refusé, abandonné, ou panier Tebex non créé.
/// REMBOURSEE : remboursement effectué, ou litige perdu.
/// LITIGE     : litige ouvert par le client, en cours d'arbitrage. La commande
///              a le plus souvent déjà été livrée — `livreeAt` reste posé,
///              c'est lui qui permet de le savoir.
enum StatutCommande {
  EN_ATTENTE
  PAYEE
  LIVREE
  ECHOUEE
  REMBOURSEE
  LITIGE
}

enum TypeArticle {
  KIT
  GRADE
  PACK
}

model Commande {
  /// Identifiant non devinable : c'est lui qui sert d'URL de confirmation.
  id String @id @default(cuid())

  /// Numéro lisible, affiché au client et utilisé au support : LJK-000042.
  /// Séquentiel, donc jamais mis dans une URL — ce serait énumérable.
  numero Int @unique @default(autoincrement())

  /// Pseudo Minecraft de livraison, saisi par l'acheteur.
  pseudoMinecraft String

  /// Total recalculé côté serveur à partir des prix en base, jamais depuis
  /// ce que le navigateur a envoyé.
  montantTotalCentimes Int

  statut StatutCommande @default(EN_ATTENTE)

  /// Ident du panier Tebex, posé à la création de la commande.
  /// Unique, et c'est par lui qu'on retrouve la commande si le `custom` du
  /// webhook venait à manquer.
  referenceExterne String? @unique

  /// Id de transaction Tebex ("tbx-…"), posé par le webhook de paiement.
  /// C'est ce que le client voit sur son relevé et cite au support.
  transactionTebex String?

  /// Dernière erreur technique rencontrée (création du panier Tebex, webhook).
  /// Affichée dans l'admin : une commande qui échoue ne doit pas le faire
  /// en silence.
  derniereErreur String?

  createdAt DateTime  @default(now())
  payeeAt   DateTime?
  livreeAt  DateTime?

  lignes LigneCommande[]

  @@index([statut, createdAt])
  /// Sert au garde-fou anti-abus : compter les commandes non payées d'un
  /// même pseudo sur la dernière heure.
  @@index([pseudoMinecraft, statut, createdAt])
}

model LigneCommande {
  id         String      @id @default(cuid())
  commandeId String
  type       TypeArticle

  /// Un seul des trois est renseigné, selon `type`.
  kitId   String?
  gradeId String?
  packId  String?

  /// Instantanés pris AU MOMENT de l'achat. C'est ce qui permet de supprimer
  /// ou de repricer un article dans l'admin sans réécrire l'historique.
  libelle      String
  prixCentimes Int

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  kit      Kit?     @relation(fields: [kitId], references: [id], onDelete: SetNull)
  grade    Grade?   @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  pack     Pack?    @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@index([commandeId])
}

/// Journal des webhooks Tebex déjà traités.
///
/// C'est le mécanisme d'idempotence : `id` est l'identifiant du webhook fourni
/// par Tebex. On insère AVANT de traiter ; si l'insertion viole la contrainte
/// de clé primaire, l'évènement a déjà été traité et on répond 200 sans rien
/// refaire. Une même commande reçoit plusieurs évènements légitimes
/// (completed, puis refunded…), ce qu'un simple champ unique sur Commande
/// n'aurait pas su distinguer.
model EvenementTebex {
  id         String   @id
  type       String
  commandeId String?
  recuLe     DateTime @default(now())

  @@index([commandeId])
}

// ---------------------------------------------------------------------------
// ⚠⚠⚠  TABLE EXTERNE — NE JAMAIS MODIFIER NI SUPPRIMER  ⚠⚠⚠
//
// `joueur` appartient au SERVEUR MINECRAFT. Elle est créée et alimentée par
// skript-db, pas par Prisma. Le site ne fait que la LIRE (classements,
// statistiques, solde de coins).
//
// Elle est déclarée ici pour une seule raison : `prisma db push` SUPPRIME
// toute table de la base qui n'apparaît pas dans ce fichier. Sans ce modèle,
// la table et ses données disparaissent au prochain push.
//
// RÈGLES :
//   1. Ne change aucun champ, aucun type, aucune valeur par défaut. Toute
//      divergence ferait proposer un ALTER TABLE par db push — c'est-à-dire
//      une modification d'une table dont le serveur Minecraft est propriétaire.
//   2. N'écris jamais dedans depuis le site. Aucune Server Action, aucune
//      route ne doit faire de create/update/delete sur ce modèle.
//   3. Si skript-db fait évoluer la table, refais une introspection
//      (`npx prisma db pull` dans un fichier à part) et recopie le résultat
//      ici À L'IDENTIQUE.
//
// La structure ci-dessous est le résultat exact d'une introspection Prisma
// de la vraie table : types, précision du timestamp et valeurs par défaut
// compris. Vérifié avec `npm run db:diff` : aucune modification proposée.
// ---------------------------------------------------------------------------
model Joueur {
  /// UUID Minecraft du joueur, tel que le serveur l'écrit.
  uuid   String @id
  pseudo String

  kills  Int @default(0)
  morts  Int @default(0)
  points Int @default(0)
  coins  Int @default(0)

  recordSerie   Int @default(0) @map("record_serie")
  hebdoPoints   Int @default(0) @map("hebdo_points")
  mensuelPoints Int @default(0) @map("mensuel_points")

  /// timestamptz(6) côté PostgreSQL : la précision doit rester explicite,
  /// sinon Prisma proposerait de la ramener à 3.
  derniereMaj DateTime @default(now()) @map("derniere_maj") @db.Timestamptz(6)

  // Index créés par skript-db pour les classements. `map:` reprend leur nom
  // exact et `sort: Desc` leur sens : sans ces trois lignes, db push les
  // SUPPRIMERAIT, et les requêtes de classement du serveur passeraient en
  // parcours complet de table sans que rien ne le signale.
  @@index([kills(sort: Desc)], map: "idx_kills")
  @@index([hebdoPoints(sort: Desc)], map: "idx_hebdo")
  @@index([mensuelPoints(sort: Desc)], map: "idx_mensuel")
  @@map("joueur")
}

/// Dates de remise à zéro des classements.
///
/// Table créée par Prisma (elle est dans les migrations) mais ÉCRITE par le
/// SERVEUR MINECRAFT, en SQL brut : c'est lui qui sait quand il remet les
/// compteurs à zéro. Le site ne fait que la lire.
///
/// Le @@map en snake_case n'est pas cosmétique : sans lui, PostgreSQL rendrait
/// le nom sensible à la casse et skript-db devrait écrire
/// `INSERT INTO "ConfigClassement"` avec les guillemets. Là, un simple
/// `INSERT INTO config_classement (cle, valeur) VALUES ('hebdo_fin', 1755648000)`
/// suffit.
model ConfigClassement {
  /// "hebdo_fin" ou "mensuel_fin".
  cle String @id

  /// Timestamp unix en SECONDES de la prochaine remise à zéro.
  /// BigInt côté base ; converti en Number avant d'être envoyé au composant
  /// client, qui ne saurait pas sérialiser un BigInt.
  valeur BigInt

  @@map("config_classement")
}

/// Les réglages du site, modifiables depuis l'admin.
///
/// Tout ce qui change au fil du temps sans mériter un déploiement : l'adresse
/// du serveur, le lien Discord, les URL de vote. Avant, c'était en dur dans
/// src/lib/site.ts — donc chaque changement demandait une modification de code.
///
/// Table à UNE SEULE LIGNE, d'id 1. On l'upserte toujours sur cet id : pas de
/// création accidentelle d'une seconde ligne de réglages qui ne servirait
/// jamais. Si la ligne n'existe pas, le site retombe sur les valeurs par défaut
/// de src/lib/site.ts plutôt que de planter.
model Reglages {
  id Int @id @default(1)

  /// Adresse du serveur Minecraft, affichée et copiée partout.
  ip String

  /// Invitation Discord. Reprise aussi dans le règlement via {discord}.
  discord String

  /// URL de vote. Vide = le serveur n'est pas encore inscrit sur ce site,
  /// le bouton reste affiché mais inerte.
  urlServeurPrive      String @default("")
  urlTopServeurs       String @default("")
  urlServeursMinecraft String @default("")

  updatedAt DateTime @updatedAt

  @@map("reglages")
}

// ---------------------------------------------------------------------------
// AUDIENCE
//
// Suivi maison des pages vues, pour /admin/stats. Volontairement minimal :
// aucune adresse IP, aucun user-agent, aucun cookie. Un identifiant de visite
// anonyme, tiré au hasard et rangé dans le sessionStorage du navigateur, suffit
// à distinguer deux visiteurs sans jamais identifier personne.
//
// Les pages /admin ne sont jamais enregistrées : ce sont les tiennes, elles
// fausseraient les chiffres.
// ---------------------------------------------------------------------------

/// Le type d'appareil, déduit côté client de la largeur et du pointeur.
enum TypeAppareil {
  MOBILE
  TABLETTE
  BUREAU
}

model VuePage {
  id String @id @default(cuid())

  /// Chemin réel visité : "/", "/kits/kitsune", "/boutique"…
  /// Sans query string : elle n'apporte rien et peut contenir n'importe quoi.
  chemin String

  /// Identifiant de visite anonyme, constant le temps d'un onglet.
  /// C'est lui qui permet de compter des VISITEURS et pas seulement des vues.
  visiteId String

  /// Temps passé sur la page, en millisecondes. `null` tant que le visiteur
  /// n'a pas quitté la page — une vue sans durée est une page encore ouverte,
  /// ou un départ que le navigateur n'a pas eu le temps de signaler.
  dureeMs Int?

  /// Domaine de provenance ("google.com"), jamais l'URL complète.
  /// `null` = accès direct, ou navigation interne au site.
  source String?

  appareil TypeAppareil

  createdAt DateTime @default(now())

  /// Les trois lectures de /admin/stats : par période, par page, par visiteur.
  @@index([createdAt])
  @@index([chemin, createdAt])
  @@index([visiteId])
}
