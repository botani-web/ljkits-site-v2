# ---------------------------------------------------------------------------
# Copier ce fichier en .env.local pour le développement,
# et reporter ces trois variables dans Vercel > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Neon : chaîne de connexion "pooled" (celle qui contient -pooler), avec sslmode=require
DATABASE_URL="postgresql://user:motdepasse@ep-xxx-pooler.eu-central-1.aws.neon.tech/ljkits?sslmode=require"

# Secret de signature des jetons NextAuth. Générer avec : npx auth secret
AUTH_SECRET="a-remplacer-par-une-valeur-aleatoire-longue"

# URL publique du site, utilisée pour les métadonnées Open Graph absolues.
NEXT_PUBLIC_SITE_URL="https://ljkits.eu"

# ---------------------------------------------------------------------------
# COLLECTE DE FRÉQUENTATION
#
# Secret partagé qui protège POST /api/frequentation (le VPS y pousse le nombre
# de joueurs toutes les 10 min) et le cron de maintenance Vercel. Générer une
# valeur aléatoire longue, la poser ICI (Vercel) ET dans le .env du bot sur le
# VPS — c'est la MÊME valeur des deux côtés. Sans elle, les deux répondent 401.
#   Générer : openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET="a-remplacer-par-une-valeur-aleatoire-longue"

# ---------------------------------------------------------------------------
# Utilisées uniquement par le script de seed (npm run db:seed) pour créer
# ou mettre à jour le compte admin. Inutiles en production.
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@ljkits.eu"
ADMIN_MOT_DE_PASSE="change-moi-avant-le-premier-seed"

# ---------------------------------------------------------------------------
# TEBEX (phase 3) — boutique et paiement
# ---------------------------------------------------------------------------

# Public Token du projet, onglet API Keys de Tebex.
# Sert à créer les paniers via l'API Headless. Il est public par nature :
# il ne donne accès à rien d'autre que la création de paniers.
TEBEX_PUBLIC_TOKEN="ton-public-token"

# Secret Key du webhook, générée à la création de l'endpoint dans Tebex.
# C'est elle qui prouve qu'un webhook vient bien de Tebex. Sans elle,
# n'importe qui pourrait se faire livrer gratuitement.
TEBEX_WEBHOOK_SECRET="ta-secret-key-de-webhook"

# Le Project ID et la Private Key de Tebex ne servent PAS ici : ils sont
# destinés à la Plugin API, utilisée par le plugin installé sur le serveur
# Minecraft. C'est lui qui livre en jeu — le site ne fait que vendre.

# Resend — posées automatiquement par l'intégration Vercel Marketplace
# (npx vercel integration add resend/resend-email -m domain=... -m region=...).
# Sans RESEND_API_KEY, les notifications de commande sont simplement ignorées :
# rien ne casse, ni le paiement, ni le webhook.
RESEND_API_KEY=""
RESEND_EMAIL_DOMAIN="ljkits.eu"

# Expéditeur. Laisser VIDE en temps normal : il est déduit de
# RESEND_EMAIL_DOMAIN (notifications@ljkits.eu). À ne renseigner que pour
# forcer une autre adresse.
#
# ATTENTION : tant que le domaine n'est pas vérifié chez Resend (DKIM + SPF
# dans le DNS), tout envoi est refusé en 403. Le domaine de test resend.dev
# ne dépanne pas : il n'écrit qu'à l'adresse du compte Resend lui-même.
EMAIL_EXPEDITEUR=""

# Destinataire des notifications d'administration.
EMAIL_ADMIN="admin@ljkits.eu"
